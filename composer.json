{
    "name": "ely/quotes-package",
    "description": "Paquete para manejar quotes",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Vendor\\Quotes\\": "src/",
            "Vendor\\Quotes\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "laravel/framework": "^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vendor\\Quotes\\Providers\\QuoteServiceProvider"
            ]
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2",
        "orchestra/testbench": "^10.9"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
